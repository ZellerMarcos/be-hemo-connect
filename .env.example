# SQL Server: substitua os valores pelos dados do ambiente autorizado.
DATABASE_URL=mssql+pyodbc://USUARIO:SENHA@SERVIDOR/BANCO?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# URL base das rotas de hemocentros do backend.
HEMOCENTROS_API_URL=http://127.0.0.1:8000/hemocentros

# SMTP utilizado para enviar os códigos temporários de 2FA.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_FROM=seu-email@gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

